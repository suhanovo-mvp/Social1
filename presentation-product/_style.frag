<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@400;700&family=PT+Sans:wght@400;700&family=PT+Mono&display=swap">
  <style>
    body { margin: 0; }
    .sl { width: 1280px; height: 720px; position: relative; overflow: hidden;
          font-family: "PT Sans", "Segoe UI", system-ui, sans-serif; color: #141b28;
          background: #ffffff; }
    .rule { position: absolute; top: 0; left: 0; right: 0; height: 6px; background: #1b3a6b; }
    .eyebrow { font-family: "PT Mono", ui-monospace, monospace; font-size: 15px;
               letter-spacing: .14em; text-transform: uppercase; color: #7c8798; }
    h2 { font-family: "PT Serif", Georgia, serif; font-size: 44px; font-weight: 700;
         line-height: 1.14; letter-spacing: -.015em; margin: 0; text-wrap: balance; }
    h3 { font-family: "PT Serif", Georgia, serif; font-size: 19px; font-weight: 700;
         letter-spacing: -.01em; margin: 0; }
    .lede { font-size: 21px; line-height: 1.5; color: #4a5568; }
    .card { background: #f9fafc; border: 1px solid #dfe4ed; border-radius: 10px; padding: 17px 19px; }
    .card p { margin: 8px 0 0; font-size: 15px; line-height: 1.5; color: #4a5568; }
    .tag { font-family: "PT Mono", ui-monospace, monospace; font-size: 12px;
           letter-spacing: .09em; text-transform: uppercase; color: #7c8798; }
    .tbl { width: 100%; border-collapse: collapse; font-size: 15px; }
    .tbl th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .06em;
              color: #7c8798; font-weight: 700; padding: 0 16px 8px 0; border-bottom: 1px solid #dfe4ed; }
    .tbl td { padding: 6px 16px 6px 0; border-bottom: 1px solid #eef1f6; color: #4a5568; }
    .tbl td b { color: #141b28; font-weight: 700; }
    .foot { position: absolute; left: 64px; right: 64px; bottom: 30px;
            display: flex; justify-content: space-between; align-items: center;
            font-size: 14px; color: #a3adbd; border-top: 1px solid #dfe4ed; padding-top: 12px; }
    .num { font-family: "PT Mono", monospace; }
    a { color: #24508f; } a:hover { color: #12294c; }
  </style>
</helmet>
